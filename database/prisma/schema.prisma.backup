datasource db { provider = "postgresql" }
generator client { provider = "prisma-client" output = "./generated" }

enum Role { OWNER ADMIN ENGINEER VIEWER INCIDENT_RESPONDER }
enum EnvironmentKind { PRODUCTION STAGING DEVELOPMENT }
enum IncidentSeverity { SEV1 SEV2 SEV3 SEV4 }
enum IncidentStatus { OPEN INVESTIGATING MITIGATING RESOLVED CLOSED }

model Organization { id String @id @default(cuid()) name String slug String @unique createdAt DateTime @default(now()) updatedAt DateTime @updatedAt users OrganizationUser[] projects Project[] }
model User { id String @id @default(cuid()) email String @unique name String? createdAt DateTime @default(now()) organizations OrganizationUser[] auditLogs AuditLog[] }
model OrganizationUser { id String @id @default(cuid()) organizationId String userId String role Role organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@unique([organizationId,userId]) @@index([organizationId,role]) }
model Project { id String @id @default(cuid()) organizationId String name String slug String environments Environment[] services Service[] organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) @@unique([organizationId,slug]) }
model Environment { id String @id @default(cuid()) projectId String name String kind EnvironmentKind project Project @relation(fields:[projectId],references:[id],onDelete:Cascade) services Service[] @@unique([projectId,name]) }
model Service { id String @id @default(cuid()) projectId String environmentId String name String slug String status String @default("healthy") project Project @relation(fields:[projectId],references:[id],onDelete:Cascade) environment Environment @relation(fields:[environmentId],references:[id],onDelete:Cascade) logs Log[] traces Trace[] metrics Metric[] deployments Deployment[] incidents Incident[] @@unique([environmentId,slug]) @@index([projectId,status]) }
model Metric { id String @id @default(cuid()) serviceId String name String value Float timestamp DateTime labels Json service Service @relation(fields:[serviceId],references:[id],onDelete:Cascade) @@index([serviceId,name,timestamp]) }
model Log { id String @id @default(cuid()) serviceId String level String message String timestamp DateTime traceId String? requestId String? metadata Json? service Service @relation(fields:[serviceId],references:[id],onDelete:Cascade) @@index([serviceId,timestamp]) @@index([traceId]) @@index([requestId]) }
model Trace { id String @id @default(cuid()) serviceId String traceId String spanId String name String durationMs Int status String timestamp DateTime service Service @relation(fields:[serviceId],references:[id],onDelete:Cascade) spans Span[] @@unique([serviceId,spanId]) @@index([traceId,timestamp]) }
model Span { id String @id @default(cuid()) traceId String spanId String parentSpanId String? serviceId String name String durationMs Int status String timestamp DateTime @@index([traceId]) }
model Incident { id String @id @default(cuid()) number Int @unique serviceId String title String severity IncidentSeverity status IncidentStatus startedAt DateTime resolvedAt DateTime? rootCause String? impact String? confidence Float? evidence Json? service Service @relation(fields:[serviceId],references:[id],onDelete:Cascade) @@index([serviceId,status]) }
model Alert { id String @id @default(cuid()) organizationId String name String condition Json enabled Boolean @default(true) createdAt DateTime @default(now()) }
model Monitor { id String @id @default(cuid()) organizationId String name String query Json intervalSeconds Int enabled Boolean @default(true) }
model SLO { id String @id @default(cuid()) serviceId String name String target Float windowSeconds Int current Float service Service @relation(fields:[serviceId],references:[id],onDelete:Cascade) @@unique([serviceId,name]) }
model Deployment { id String @id @default(cuid()) serviceId String version String deployedAt DateTime status String metadata Json? service Service @relation(fields:[serviceId],references:[id],onDelete:Cascade) @@index([serviceId,deployedAt]) }
model AuditLog { id String @id @default(cuid()) organizationId String userId String action String resource String resourceId String? metadata Json? createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id]) @@index([organizationId,createdAt]) }
